{
  "$defs": {
    "ErrorMessage": {
      "additionalProperties": false,
      "properties": {
        "code": {
          "title": "Code",
          "type": "string"
        },
        "message": {
          "title": "Message",
          "type": "string"
        },
        "type": {
          "const": "error",
          "default": "error",
          "title": "Type",
          "type": "string"
        }
      },
      "required": [
        "code",
        "message"
      ],
      "title": "ErrorMessage",
      "type": "object"
    },
    "EventMessage": {
      "additionalProperties": false,
      "properties": {
        "at": {
          "format": "date-time",
          "title": "At",
          "type": "string"
        },
        "channel": {
          "enum": [
            "status",
            "decisions",
            "orders",
            "trades",
            "equity",
            "alerts",
            "heartbeat"
          ],
          "title": "Channel",
          "type": "string"
        },
        "data": {
          "additionalProperties": true,
          "title": "Data",
          "type": "object"
        },
        "id": {
          "examples": [
            "a1b2c3d4:1042"
          ],
          "title": "Id",
          "type": "string"
        },
        "type": {
          "const": "event",
          "default": "event",
          "title": "Type",
          "type": "string"
        }
      },
      "required": [
        "id",
        "channel",
        "at",
        "data"
      ],
      "title": "EventMessage",
      "type": "object"
    },
    "HelloMessage": {
      "additionalProperties": false,
      "properties": {
        "channels": {
          "items": {
            "enum": [
              "status",
              "decisions",
              "orders",
              "trades",
              "equity",
              "alerts",
              "heartbeat"
            ],
            "type": "string"
          },
          "title": "Channels",
          "type": "array"
        },
        "epoch": {
          "description": "Muda quando a API reinicia: `last_event_id` de outra época não retoma.",
          "title": "Epoch",
          "type": "string"
        },
        "ping_seconds": {
          "title": "Ping Seconds",
          "type": "number"
        },
        "role": {
          "enum": [
            "admin",
            "reader"
          ],
          "title": "Role",
          "type": "string"
        },
        "runner_connected": {
          "title": "Runner Connected",
          "type": "boolean"
        },
        "server_time": {
          "format": "date-time",
          "title": "Server Time",
          "type": "string"
        },
        "type": {
          "const": "hello",
          "default": "hello",
          "title": "Type",
          "type": "string"
        }
      },
      "required": [
        "server_time",
        "epoch",
        "channels",
        "ping_seconds",
        "runner_connected",
        "role"
      ],
      "title": "HelloMessage",
      "type": "object"
    },
    "PingMessage": {
      "additionalProperties": false,
      "properties": {
        "at": {
          "format": "date-time",
          "title": "At",
          "type": "string"
        },
        "type": {
          "const": "ping",
          "default": "ping",
          "title": "Type",
          "type": "string"
        }
      },
      "required": [
        "at"
      ],
      "title": "PingMessage",
      "type": "object"
    },
    "PongMessage": {
      "additionalProperties": false,
      "properties": {
        "type": {
          "const": "pong",
          "title": "Type",
          "type": "string"
        }
      },
      "required": [
        "type"
      ],
      "title": "PongMessage",
      "type": "object"
    },
    "ResyncMessage": {
      "additionalProperties": false,
      "properties": {
        "reason": {
          "title": "Reason",
          "type": "string"
        },
        "type": {
          "const": "resync",
          "default": "resync",
          "title": "Type",
          "type": "string"
        }
      },
      "required": [
        "reason"
      ],
      "title": "ResyncMessage",
      "type": "object"
    },
    "RunnerMessage": {
      "additionalProperties": false,
      "properties": {
        "connected": {
          "title": "Connected",
          "type": "boolean"
        },
        "last_heartbeat_at": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Last Heartbeat At"
        },
        "message": {
          "examples": [
            "Desconectado do robô: sem sinal há mais de 90 segundos."
          ],
          "title": "Message",
          "type": "string"
        },
        "type": {
          "const": "runner",
          "default": "runner",
          "title": "Type",
          "type": "string"
        }
      },
      "required": [
        "connected",
        "message"
      ],
      "title": "RunnerMessage",
      "type": "object"
    },
    "SubscribeMessage": {
      "additionalProperties": false,
      "properties": {
        "channels": {
          "items": {
            "enum": [
              "status",
              "decisions",
              "orders",
              "trades",
              "equity",
              "alerts",
              "heartbeat"
            ],
            "type": "string"
          },
          "maxItems": 7,
          "minItems": 1,
          "title": "Channels",
          "type": "array"
        },
        "last_event_id": {
          "anyOf": [
            {
              "maxLength": 40,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "`id` do último `event` recebido; permite retomar.",
          "title": "Last Event Id"
        },
        "type": {
          "const": "subscribe",
          "title": "Type",
          "type": "string"
        }
      },
      "required": [
        "type",
        "channels"
      ],
      "title": "SubscribeMessage",
      "type": "object"
    },
    "SubscribedMessage": {
      "additionalProperties": false,
      "properties": {
        "channels": {
          "items": {
            "enum": [
              "status",
              "decisions",
              "orders",
              "trades",
              "equity",
              "alerts",
              "heartbeat"
            ],
            "type": "string"
          },
          "title": "Channels",
          "type": "array"
        },
        "replayed": {
          "default": 0,
          "title": "Replayed",
          "type": "integer"
        },
        "resumed": {
          "description": "Verdadeiro: as mensagens perdidas foram reenviadas.",
          "title": "Resumed",
          "type": "boolean"
        },
        "type": {
          "const": "subscribed",
          "default": "subscribed",
          "title": "Type",
          "type": "string"
        }
      },
      "required": [
        "channels",
        "resumed"
      ],
      "title": "SubscribedMessage",
      "type": "object"
    },
    "UnsubscribeMessage": {
      "additionalProperties": false,
      "properties": {
        "channels": {
          "items": {
            "enum": [
              "status",
              "decisions",
              "orders",
              "trades",
              "equity",
              "alerts",
              "heartbeat"
            ],
            "type": "string"
          },
          "maxItems": 7,
          "minItems": 1,
          "title": "Channels",
          "type": "array"
        },
        "type": {
          "const": "unsubscribe",
          "title": "Type",
          "type": "string"
        }
      },
      "required": [
        "type",
        "channels"
      ],
      "title": "UnsubscribeMessage",
      "type": "object"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "channels": [
    "status",
    "decisions",
    "orders",
    "trades",
    "equity",
    "alerts",
    "heartbeat"
  ],
  "clientMessage": {
    "discriminator": {
      "mapping": {
        "pong": "#/$defs/PongMessage",
        "subscribe": "#/$defs/SubscribeMessage",
        "unsubscribe": "#/$defs/UnsubscribeMessage"
      },
      "propertyName": "type"
    },
    "oneOf": [
      {
        "$ref": "#/$defs/SubscribeMessage"
      },
      {
        "$ref": "#/$defs/UnsubscribeMessage"
      },
      {
        "$ref": "#/$defs/PongMessage"
      }
    ]
  },
  "description": "Contrato das mensagens do WebSocket `/ws` (exportado em `api/ws_schema.json`).\n\nFluxo: o painel abre `/ws` (cookie de sessão + `Origin` do painel), recebe `hello`, envia `subscribe` com os\ncanais e, opcionalmente, o `last_event_id` da última mensagem recebida (retomada sem perda quando possível).\nO servidor envia `ping` periodicamente; o cliente responde `pong`. Mensagens `event` trazem o `id` a guardar.",
  "serverMessage": {
    "discriminator": {
      "mapping": {
        "error": "#/$defs/ErrorMessage",
        "event": "#/$defs/EventMessage",
        "hello": "#/$defs/HelloMessage",
        "ping": "#/$defs/PingMessage",
        "resync": "#/$defs/ResyncMessage",
        "runner": "#/$defs/RunnerMessage",
        "subscribed": "#/$defs/SubscribedMessage"
      },
      "propertyName": "type"
    },
    "oneOf": [
      {
        "$ref": "#/$defs/HelloMessage"
      },
      {
        "$ref": "#/$defs/SubscribedMessage"
      },
      {
        "$ref": "#/$defs/EventMessage"
      },
      {
        "$ref": "#/$defs/RunnerMessage"
      },
      {
        "$ref": "#/$defs/ResyncMessage"
      },
      {
        "$ref": "#/$defs/PingMessage"
      },
      {
        "$ref": "#/$defs/ErrorMessage"
      }
    ]
  },
  "title": "CryptoInvest WebSocket /ws"
}
