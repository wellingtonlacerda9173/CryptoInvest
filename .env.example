# Copie para .env. Contem apenas configuracao NAO secreta.
# Segredos ficam em arquivos dentro de SECRETS_DIR (um arquivo por segredo, nome = campo):
#   database_password, binance_api_key, binance_api_secret
# Em producao/Docker: /run/secrets. Em dev: ./secrets (criado por scripts/init-dev.ps1).
SECRETS_DIR=./secrets

ENVIRONMENT=dev
LOG_LEVEL=INFO

DATABASE_HOST=127.0.0.1
DATABASE_PORT=5432
DATABASE_NAME=cryptoinvest
DATABASE_USER=cryptoinvest

REDIS_URL=redis://127.0.0.1:6379/0

BINANCE_REST_URL=https://api.binance.com/api/v3
BINANCE_WS_URL=wss://stream.binance.com:9443
# Runner do paper: a porta 443 funciona onde a 9443 e bloqueada (tambem configuravel por --ws-url)
PAPER_WS_URL=wss://stream.binance.com:443

# API do painel (prefixo API_). Segredos (arquivos em SECRETS_DIR): api_session_secret, api_master_keys
# API_PANEL_ORIGINS=["http://localhost:3000"]
# API_COOKIE_SECURE=false        # so em dev sem HTTPS; em producao deve ser true
# API_HSTS_MAX_AGE_SECONDS=31536000
# API_TRUST_FORWARDED_FOR=false  # true so atras de proxy confiavel (usa o ultimo salto do X-Forwarded-For)

# Canal de comandos e tempo real (API <-> runner). Segredo (arquivo em SECRETS_DIR): command_hmac_key
# (python -m api.cli init-secrets); API e runner precisam apontar para o MESMO SECRETS_DIR e o MESMO Redis.
# Prefira 127.0.0.1 a localhost no REDIS_URL: algumas maquinas resolvem localhost para ::1 e o Docker so publica em IPv4.
# API_REDIS_URL=redis://127.0.0.1:6379/0       # padrao: o REDIS_URL acima
# API_RUNNER_DATA_DIR=./data/paper              # opcional: reserva por arquivo e leitura de status.json
# API_RUNNER_START_COMMAND=["uv","run","python","-m","engine.runner.paper","start"]   # opcional: liga o robo pelo painel
# API_BACKTEST_MAX_CONCURRENT=1
# API_BACKTEST_TIMEOUT_SECONDS=1800
# API_BACKTEST_MAX_MEMORY_MB=2048
# API_CALENDAR_PATH=/var/lib/cryptoinvest/calendar/volatility_events.json   # calendario mutavel (volume do updater); sem ele a API usa so a semente config/volatility_events.json

# Alertas externos (DESLIGADOS por padrao). Segredos em arquivos de SECRETS_DIR: telegram_bot_token, smtp_password
# NOTIFY_ENABLED=false
# NOTIFY_TELEGRAM_CHAT_ID=
# NOTIFY_SMTP_HOST=
# NOTIFY_SMTP_PORT=587
# NOTIFY_SMTP_USER=
# NOTIFY_SMTP_FROM=
# NOTIFY_SMTP_TO=["alguem@exemplo.com"]
